import os
import numpy as np
import pandas as pd
from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# V15.3：加入基础特征组合和 RandomForest 对比
DATA_PATH = r"E:\桌面\Milk\积分milk.xlsx"
SAVE_FOLDER = r"E:\桌面\Milk\V15.3_results"
SEED = 888
os.makedirs(SAVE_FOLDER, exist_ok=True)
df = pd.read_excel(DATA_PATH).rename(columns={"PS(%)": "PS", "KOH(%)": "KOH"})
base = ["PS", "KOH", "R1o", "R2o", "R3o", "R4o", "R5o", "HIX"]
df = df.dropna(subset=base).reset_index(drop=True)
eps = 1e-8
df["Reaction_Intensity"] = df["PS"] * df["KOH"]
df["Dosage_Ratio"] = df["PS"] / (df["KOH"] + eps)
df["Degradation_Potential"] = (df["R1o"] + df["R2o"]) / (df["R5o"] + eps)
df["R1o_R2o"] = df["R1o"] / (df["R2o"] + eps)
df["R3o_R4o"] = df["R3o"] / (df["R4o"] + eps)
features = base[:-1] + [
    "Reaction_Intensity", "Dosage_Ratio", "Degradation_Potential",
    "R1o_R2o", "R3o_R4o"
]
X_train, X_test, y_train, y_test = train_test_split(
    df[features], df["HIX"], test_size=0.2, random_state=SEED
)
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)
models = {
    "GradientBoosting": GradientBoostingRegressor(
        n_estimators=200, learning_rate=0.03, max_depth=3, random_state=SEED
    ),
    "RandomForest": RandomForestRegressor(
        n_estimators=200, max_depth=6, random_state=SEED, n_jobs=1
    ),
}
rows = []
for name, model in models.items():
    model.fit(X_train, y_train)
    prediction = model.predict(X_test)
    rows.append({
        "Model": name,
        "R2": r2_score(y_test, prediction),
        "MAE": mean_absolute_error(y_test, prediction),
        "RMSE": np.sqrt(mean_squared_error(y_test, prediction)),
    })
pd.DataFrame(rows).sort_values("R2", ascending=False).to_csv(
    os.path.join(SAVE_FOLDER, "model_results.csv"),
    index=False, encoding="utf-8-sig"
)
print(pd.DataFrame(rows).sort_values("R2", ascending=False).to_string(index=False))
