import os
import tempfile
import numpy as np
import pandas as pd
import joblib as jl
import optuna

from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score

from sklearn.svm import SVR
from sklearn.ensemble import RandomForestRegressor
import xgboost as xgb


# ====================== 临时文件夹修正 ======================
tempfile.tempdir = r"C:\Temp"
os.makedirs(tempfile.tempdir, exist_ok=True)

# ====================== 路径（你只需要改这里） ======================
DATA_PATH = r"E:\桌面\Milk\数据库-积分强度.xlsx"
SAVE_FOLDER = r"E:\桌面\Milk\数据库-积分强度_OPTUNA"
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== 读取数据 ======================
df = pd.read_excel(DATA_PATH)
df = df.rename(columns={'PS(%)': 'PS', 'KOH(%)': 'KOH'})

# ====================== 特征工程 ======================
df['Reaction_Intensity'] = df['PS'] * df['KOH']
df['Dosage_Ratio'] = df['KOH'] / (df['PS'] + 1e-6)
df['Degradation_Potential'] = (df['R1o'] + df['R2o']) / (df['R5o'] + 1e-6)

# ====================== 标签 ======================
y = df['HIX'].values

# ====================== 特征 ======================
features = [
    'PS', 'KOH',
    'Reaction_Intensity',
    'Dosage_Ratio',
    'Degradation_Potential',
    'R5o', 'R4o', 'R3o', 'R2o', 'R1o'
]
X = df[features].values

# ====================== 划分数据 ======================
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=28
)

# ====================== 标准化（只给 SVR 用） ======================
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

jl.dump(scaler, os.path.join(SAVE_FOLDER, "scaler_X.pkl"))


# ==========================================================
# ⭐ 1) SVR 自动调参
# ==========================================================
def objective_svr(trial):
    C = trial.suggest_float("C", 0.1, 500, log=True)
    epsilon = trial.suggest_float("epsilon", 0.001, 0.3)
    gamma = trial.suggest_float("gamma", 0.001, 1.0, log=True)

    model = SVR(kernel="rbf", C=C, epsilon=epsilon, gamma=gamma)

    score = cross_val_score(
        model, X_train_scaled, y_train,
        cv=5, scoring="r2", n_jobs=-1
    ).mean()

    return score


print("\n==============================")
print(" Optuna Tuning SVR (150 trials)")
print("==============================")

study_svr = optuna.create_study(direction="maximize")
study_svr.optimize(objective_svr, n_trials=150)

best_svr = SVR(kernel="rbf", **study_svr.best_params)
best_svr.fit(X_train_scaled, y_train)

svr_train_r2 = r2_score(y_train, best_svr.predict(X_train_scaled))
svr_test_r2 = r2_score(y_test, best_svr.predict(X_test_scaled))

print("\nBest SVR Params:", study_svr.best_params)
print(f"SVR | Train R2: {svr_train_r2:.3f}, Test R2: {svr_test_r2:.3f}, CV R2: {study_svr.best_value:.3f}")

jl.dump(best_svr, os.path.join(SAVE_FOLDER, "SVR_best.pkl"))


# ==========================================================
# ⭐ 2) RandomForest 自动调参
# ==========================================================
def objective_rf(trial):
    params = {
        "n_estimators": trial.suggest_int("n_estimators", 300, 2000),
        "max_depth": trial.suggest_int("max_depth", 3, 40),
        "min_samples_split": trial.suggest_int("min_samples_split", 2, 20),
        "min_samples_leaf": trial.suggest_int("min_samples_leaf", 1, 10),
        "max_features": trial.suggest_categorical("max_features", ["sqrt", "log2", None]),
        "bootstrap": trial.suggest_categorical("bootstrap", [True, False]),
        "random_state": 28,
        "n_jobs": -1
    }

    model = RandomForestRegressor(**params)

    score = cross_val_score(
        model, X_train, y_train,
        cv=5, scoring="r2", n_jobs=-1
    ).mean()

    return score


print("\n======================================")
print(" Optuna Tuning RandomForest (120 trials)")
print("======================================")

study_rf = optuna.create_study(direction="maximize")
study_rf.optimize(objective_rf, n_trials=120)

best_rf = RandomForestRegressor(
    **study_rf.best_params,
    random_state=28,
    n_jobs=-1
)

best_rf.fit(X_train, y_train)

rf_train_r2 = r2_score(y_train, best_rf.predict(X_train))
rf_test_r2 = r2_score(y_test, best_rf.predict(X_test))

print("\nBest RF Params:", study_rf.best_params)
print(f"RF | Train R2: {rf_train_r2:.3f}, Test R2: {rf_test_r2:.3f}, CV R2: {study_rf.best_value:.3f}")

jl.dump(best_rf, os.path.join(SAVE_FOLDER, "RandomForest_best.pkl"))


# ==========================================================
# ⭐ 3) XGBoost 自动调参
# ==========================================================
def objective_xgb(trial):
    params = {
        "n_estimators": trial.suggest_int("n_estimators", 400, 2500),
        "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.2, log=True),
        "max_depth": trial.suggest_int("max_depth", 3, 12),
        "subsample": trial.suggest_float("subsample", 0.6, 1.0),
        "colsample_bytree": trial.suggest_float("colsample_bytree", 0.6, 1.0),
        "min_child_weight": trial.suggest_int("min_child_weight", 1, 15),
        "gamma": trial.suggest_float("gamma", 0.0, 0.6),
        "reg_alpha": trial.suggest_float("reg_alpha", 0.0, 3.0),
        "reg_lambda": trial.suggest_float("reg_lambda", 0.5, 15.0),
        "random_state": 28,
        "objective": "reg:squarederror",
        "tree_method": "hist",
        "n_jobs": -1
    }

    model = xgb.XGBRegressor(**params)

    score = cross_val_score(
        model, X_train, y_train,
        cv=5, scoring="r2", n_jobs=-1
    ).mean()

    return score


print("\n=================================")
print(" Optuna Tuning XGBoost (200 trials)")
print("=================================")

study_xgb = optuna.create_study(direction="maximize")
study_xgb.optimize(objective_xgb, n_trials=200)

best_xgb = xgb.XGBRegressor(
    **study_xgb.best_params,
    random_state=28,
    objective="reg:squarederror",
    tree_method="hist",
    n_jobs=-1
)

best_xgb.fit(X_train, y_train)

xgb_train_r2 = r2_score(y_train, best_xgb.predict(X_train))
xgb_test_r2 = r2_score(y_test, best_xgb.predict(X_test))

print("\nBest XGB Params:", study_xgb.best_params)
print(f"XGB | Train R2: {xgb_train_r2:.3f}, Test R2: {xgb_test_r2:.3f}, CV R2: {study_xgb.best_value:.3f}")

jl.dump(best_xgb, os.path.join(SAVE_FOLDER, "XGBoost_best.pkl"))


# ==========================================================
# ⭐ 最终结果汇总保存
# ==========================================================
results = pd.DataFrame([
    {"Model": "SVR", "Train_R2": svr_train_r2, "Test_R2": svr_test_r2, "CV_R2": study_svr.best_value,
     "Best_Params": str(study_svr.best_params)},
    {"Model": "RandomForest", "Train_R2": rf_train_r2, "Test_R2": rf_test_r2, "CV_R2": study_rf.best_value,
     "Best_Params": str(study_rf.best_params)},
    {"Model": "XGBoost", "Train_R2": xgb_train_r2, "Test_R2": xgb_test_r2, "CV_R2": study_xgb.best_value,
     "Best_Params": str(study_xgb.best_params)}
])

results.to_csv(
    os.path.join(SAVE_FOLDER, "optuna_results.csv"),
    index=False,
    encoding="utf-8-sig"
)

print("\n================ FINAL RESULTS ================")
print(results[["Model", "Train_R2", "Test_R2", "CV_R2"]])
print("\nSaved models + results to:", SAVE_FOLDER)
