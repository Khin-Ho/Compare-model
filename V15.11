import os
import joblib
import numpy as np
import pandas as pd
from sklearn.ensemble import GradientBoostingRegressor, RandomForestRegressor
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# V15.11：保存完整模型包，便于后续直接预测
DATA_PATH = r"E:\桌面\Milk\积分milk.xlsx"
OUT = r"E:\桌面\Milk\V15.11_results"
SEED = 888
os.makedirs(OUT, exist_ok=True)
df = pd.read_excel(DATA_PATH).rename(columns={"PS(%)": "PS", "KOH(%)": "KOH"})
cols = ["PS", "KOH", "R1o", "R2o", "R3o", "R4o", "R5o", "HIX"]; df = df.dropna(subset=cols).reset_index(drop=True); eps = 1e-8
df["Reaction_Intensity"] = df.PS * df.KOH; df["Dosage_Ratio"] = df.PS / (df.KOH + eps); df["Total_Fluorescence"] = df[cols[2:7]].sum(axis=1)
df["Humic_like"] = df.R3o + df.R5o; df["Protein_like"] = df.R1o + df.R2o
features = cols[:-1] + ["Reaction_Intensity", "Dosage_Ratio", "Total_Fluorescence", "Humic_like", "Protein_like"]
Xtr, Xte, ytr, yte = train_test_split(df[features], df.HIX, test_size=0.2, random_state=SEED); scaler = StandardScaler(); Xtr, Xte = scaler.fit_transform(Xtr), scaler.transform(Xte)
models = {"GradientBoosting": GradientBoostingRegressor(n_estimators=200, learning_rate=0.03, max_depth=3, random_state=SEED), "RandomForest": RandomForestRegressor(n_estimators=200, max_depth=6, random_state=SEED, n_jobs=1)}
rows = []; fitted = {}
for name, model in models.items():
    model.fit(Xtr, ytr); fitted[name] = model; p = model.predict(Xte)
    rows.append({"Model": name, "R2": r2_score(yte, p), "MAE": mean_absolute_error(yte, p), "RMSE": np.sqrt(mean_squared_error(yte, p))})
results = pd.DataFrame(rows).sort_values("R2", ascending=False); best = results.iloc[0].Model
results.to_csv(os.path.join(OUT, "model_results.csv"), index=False, encoding="utf-8-sig")
joblib.dump({"model": fitted[best], "scaler": scaler, "features": features}, os.path.join(OUT, "model_package.pkl"))
print(results)
