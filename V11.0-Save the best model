import os
import tempfile
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split, GridSearchCV, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.metrics import mean_squared_error, r2_score
import joblib as jl
import xgboost as xgb

# ====================== 临时文件夹修正，避免 joblib 报错 ======================
tempfile.tempdir = r"C:\Temp"
os.makedirs(tempfile.tempdir, exist_ok=True)

# ====================== 配置 ======================
DATA_PATH = r"E:\桌面\0\ML_ready\HIX-5.csv"  # 数据路径
SAVE_FOLDER = r"E:\桌面\0\ML_ready"
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== 数据加载 ======================
print("Loading data...")
df = pd.read_csv(DATA_PATH, encoding="utf-8-sig")
print(f"Data shape: {df.shape}")

# ====================== 特征与目标 ======================
features = ['PS', 'KOH', 'Microwave', 'R1', 'R2', 'R3', 'R4', 'R5']
X = df[features].values
y = df['HIX_normalized'].values

print("Checking for missing values...")
print(df.isnull().sum())

# ====================== 标准化 + PCA ======================
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

pca = PCA(n_components=0.95)
X_pca = pca.fit_transform(X_scaled)
print(f"Original features: {X.shape[1]}, After PCA: {X_pca.shape[1]}")

# ====================== 数据集拆分 ======================
X_train, X_test, y_train, y_test = train_test_split(X_pca, y, test_size=0.2, random_state=42)
print(f"Training set: {X_train.shape}, Test set: {X_test.shape}")

# ====================== 模型字典 ======================
models = {
    "Ridge": Ridge(),
    "KNN": KNeighborsRegressor(),
    "SVR": SVR(),
    "DecisionTree": DecisionTreeRegressor(random_state=42),
    "RandomForest": RandomForestRegressor(random_state=42),
    "GradientBoosting": GradientBoostingRegressor(random_state=42),
    "XGBoost": xgb.XGBRegressor(random_state=42, n_jobs=1)
}

# ====================== 超参数 ======================
param_grid = {
    'Ridge': {'alpha': [1, 5, 10, 20]},
    'KNN': {'n_neighbors': [3,5,7,10], 'weights': ['uniform','distance'], 'p':[1,2]},
    'SVR': {'C':[0.1,1,10], 'epsilon':[0.01,0.1,0.2], 'kernel':['rbf','linear']},
    'DecisionTree': {'max_depth':[2,3,4,5], 'min_samples_split':[2,5,10], 'min_samples_leaf':[1,2,4]},
    'RandomForest': {'n_estimators':[50,100,150], 'max_depth':[3,5,7,10], 'min_samples_split':[2,5,10], 'min_samples_leaf':[1,2,4]},
    'GradientBoosting': {'n_estimators':[50,100,150], 'learning_rate':[0.01,0.03,0.05], 'max_depth':[2,3,4,5]},
    'XGBoost': {'n_estimators':[50,100,150], 'learning_rate':[0.01,0.03,0.05], 'max_depth':[2,3,4,5],
                'subsample':[0.7,0.8,1.0], 'colsample_bytree':[0.7,0.8,1.0], 'reg_alpha':[0,0.1,1], 'reg_lambda':[1,10]}
}

# ====================== 训练与评估 ======================
results = []

for name, model in models.items():
    print(f"\nTraining {name}...")
    if name in param_grid:
        grid = GridSearchCV(model, param_grid[name], cv=5, scoring='r2', n_jobs=1, verbose=1)
        grid.fit(X_train, y_train)
        best_model = grid.best_estimator_
        print(f"Best params for {name}: {grid.best_params_}")
    else:
        best_model = model
        best_model.fit(X_train, y_train)

    # 预测
    y_train_pred = best_model.predict(X_train)
    y_test_pred = best_model.predict(X_test)

    # 计算指标
    train_r2 = r2_score(y_train, y_train_pred)
    test_r2 = r2_score(y_test, y_test_pred)
    train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))
    test_rmse = np.sqrt(mean_squared_error(y_test, y_test_pred))
    cv_scores = cross_val_score(best_model, X_train, y_train, cv=5, scoring='r2', n_jobs=1)

    print(f"Train R2: {train_r2:.4f}, Test R2: {test_r2:.4f}, CV R2: {cv_scores.mean():.4f} ± {cv_scores.std():.4f}")

    results.append({
        'Model': name,
        'Train_R2': train_r2,
        'Test_R2': test_r2,
        'Train_RMSE': train_rmse,
        'Test_RMSE': test_rmse,
        'CV_R2_mean': cv_scores.mean(),
        'CV_R2_std': cv_scores.std(),
        'Model_object': best_model  # 添加模型对象以便后续保存
    })

# ====================== 排序并选择最优模型 ======================
# 按照 Test_R2 排序，选择前 3 个最优模型
results_sorted = sorted(results, key=lambda x: x['Test_R2'], reverse=True)
top_3_models = results_sorted[:3]

# ====================== 保存最优模型 ======================
for i, result in enumerate(top_3_models):
    model_name = result['Model']
    model = result['Model_object']
    jl.dump(model, os.path.join(SAVE_FOLDER, f"top_{i+1}_model_{model_name}.pkl"))
    print(f"Saved top {i+1} model: {model_name}")

# ====================== 保存模型性能 ======================
results_df = pd.DataFrame([{
    'Model': result['Model'],
    'Train_R2': result['Train_R2'],
    'Test_R2': result['Test_R2'],
    'Train_RMSE': result['Train_RMSE'],
    'Test_RMSE': result['Test_RMSE'],
    'CV_R2_mean': result['CV_R2_mean'],
    'CV_R2_std': result['CV_R2_std'],
} for result in top_3_models])

results_df.to_csv(os.path.join(SAVE_FOLDER, 'top_3_model_performance.csv'), index=False)
print("\n===== Final Results ======")
print(results_df)
print(f"Results saved to: {SAVE_FOLDER}")
