import os
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split, GridSearchCV, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.metrics import mean_squared_error, r2_score
import joblib as jl
import matplotlib.pyplot as plt
import seaborn as sns
import xgboost as xgb

# ====================== Configuration ======================
DATA_PATH = r"E:\桌面\try\ML_ready\HIX3.csv"
SAVE_FOLDER = r"E:\桌面\try\ML_ready"
IMAGE_FOLDER = os.path.join(SAVE_FOLDER, 'model_results')
os.makedirs(IMAGE_FOLDER, exist_ok=True)

# Set matplotlib to avoid font issues
plt.rcParams['font.sans-serif'] = ['DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# ====================== Data Loading ======================
print("Loading data...")
df = pd.read_csv(DATA_PATH, encoding="utf-8-sig")
print(f"Original data shape: {df.shape}")

# ====================== Handle missing values in target ======================
nan_count = df['HIX_normalized'].isna().sum()
print(f"Found {nan_count} missing HIX values.")
if nan_count > 0:
    # 方法 1：删除 NaN 样品
    df = df.dropna(subset=['HIX_normalized'])
    print(f"After dropping NaNs, data shape: {df.shape}")
    # 方法 2：如果不想丢样品可以使用中位数填充
    # df['HIX_normalized'] = df['HIX_normalized'].fillna(df['HIX_normalized'].median())

# ====================== Feature Engineering ======================
features = feature_cols = [
    "PS", "KOH", "Microwave",
    "region1", "region2", "region3", "region4", "region5",
    "region1_pct", "region2_pct", "region3_pct", "region4_pct", "region5_pct",
    "total_fluorescence"
]

X = df[features].values
y = df['HIX_normalized'].values

# Scale features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# PCA for dimensionality reduction
pca = PCA(n_components=0.95)  # Keep 95% variance
X_pca = pca.fit_transform(X_scaled)
print(f"Original features: {X.shape[1]}, After PCA: {X_pca.shape[1]}")

# ====================== Dataset Splitting ======================
X_train, X_test, y_train, y_test = train_test_split(
    X_pca, y, test_size=0.2, random_state=42
)
print(f"Training set: {X_train.shape}, Test set: {X_test.shape}")

# ====================== Model Definitions with Fixed Parameters ======================
models = {
    "Ridge": Ridge(alpha=10.0),
    "KNN": KNeighborsRegressor(n_neighbors=7, weights='distance'),
    "SVR": SVR(C=1.0, kernel='rbf', epsilon=0.1),
    "DecisionTree": DecisionTreeRegressor(max_depth=5, min_samples_split=5, random_state=42),
    "RandomForest": RandomForestRegressor(n_estimators=200, max_depth=10, random_state=42, n_jobs=-1),
    "GradientBoosting": GradientBoostingRegressor(n_estimators=200, learning_rate=0.1, max_depth=5, random_state=42),
    "XGBoost": xgb.XGBRegressor(n_estimators=200, learning_rate=0.1, max_depth=5, random_state=42, n_jobs=-1)
}

# ====================== Hyperparameter Tuning (GridSearchCV) ======================
param_grid = {
    'RandomForest': {
        'n_estimators': [100, 200, 300],
        'max_depth': [5, 10, 15],
        'min_samples_split': [2, 5, 10],
        'min_samples_leaf': [1, 2, 4]
    },
    'XGBoost': {
        'learning_rate': [0.01, 0.05, 0.1],
        'max_depth': [3, 5, 7],
        'n_estimators': [100, 200, 300]
    },
    'GradientBoosting': {
        'learning_rate': [0.01, 0.05, 0.1],
        'n_estimators': [100, 200, 300],
        'max_depth': [3, 5, 7]
    },
    'KNN': {
        'n_neighbors': [3, 5, 7, 10],
        'weights': ['uniform', 'distance'],
        'p': [1, 2]
    },
}

# ====================== Model Training and Evaluation ======================
print("\n" + "=" * 60)
print("Starting Model Training")
print("=" * 60)

results = []

# Loop over all models
for model_name, model in models.items():
    print(f"\nTraining {model_name}...")

    # Hyperparameter tuning using GridSearchCV
    if model_name in param_grid:
        grid_search = GridSearchCV(model, param_grid[model_name], cv=5, scoring='r2', n_jobs=1, verbose=1)
        grid_search.fit(X_train, y_train)
        best_model = grid_search.best_estimator_
        print(f"Best params for {model_name}: {grid_search.best_params_}")
    else:
        best_model = model
        best_model.fit(X_train, y_train)

    # Make predictions
    y_train_pred = best_model.predict(X_train)
    y_test_pred = best_model.predict(X_test)

    # Calculate metrics
    train_r2 = r2_score(y_train, y_train_pred)
    test_r2 = r2_score(y_test, y_test_pred)
    train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))
    test_rmse = np.sqrt(mean_squared_error(y_test, y_test_pred))

    # Cross-validation
    cv_scores = cross_val_score(best_model, X_train, y_train, cv=5, scoring='r2')
    cv_mean = cv_scores.mean()
    cv_std = cv_scores.std()

    # Print results
    print(f"  Train R2: {train_r2:.4f}")
    print(f"  Test R2: {test_r2:.4f}")
    print(f"  Test RMSE: {test_rmse:.4f}")
    print(f"  CV R2: {cv_mean:.4f} ± {cv_std:.4f}")

    # Save model
    jl.dump(best_model, os.path.join(SAVE_FOLDER, f'{model_name}_model.pkl'))

    # Store results
    results.append({
        'Model': model_name,
        'Train_R2': train_r2,
        'Test_R2': test_r2,
        'Train_RMSE': train_rmse,
        'Test_RMSE': test_rmse,
        'CV_R2_mean': cv_mean,
        'CV_R2_std': cv_std
    })

# ====================== Results Summary ======================
if results:
    results_df = pd.DataFrame(results).sort_values('Test_R2', ascending=False)
    print("\n" + "=" * 60)
    print("FINAL RESULTS SUMMARY")
    print("=" * 60)
    for i, row in results_df.iterrows():
        print(
            f"{row['Model']:15s} | Test R2: {row['Test_R2']:.4f} | Train R2: {row['Train_R2']:.4f} | CV R2: {row['CV_R2_mean']:.4f} ± {row['CV_R2_std']:.4f}"
        )

    # Save results to CSV
    results_path = os.path.join(SAVE_FOLDER, 'model_performance.csv')
    results_df.to_csv(results_path, index=False)
    print(f"\nResults saved to: {results_path}")
else:
    print("No models were successfully trained.")

print(f"\nAll outputs saved in: {SAVE_FOLDER}")
