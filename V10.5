import os
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split, KFold, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
import xgboost as xgb
import joblib as jl

# ====================== Config ======================
DATA_PATH = r"E:\桌面\6\ML_ready\HIX_train_ready.csv"
SAVE_FOLDER = r"E:\桌面\6\ML_ready"
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== Load Data ======================
df = pd.read_csv(DATA_PATH, encoding="utf-8-sig")

# ====================== Feature Engineering ======================
features = ['PS', 'KOH', 'Microwave', 'R1', 'R2', 'R3', 'R4', 'R5']

# 增加组合特征增强信号
df['R1_R2'] = df['R1'] * df['R2']
df['R3_R4'] = df['R3'] * df['R4']
df['PS_KOH'] = df['PS'] + df['KOH']

features += ['R1_R2', 'R3_R4', 'PS_KOH']

X = df[features].values
y = df['HIX_normalized'].values

# 标准化
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 数据集拆分
X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y, test_size=0.2, random_state=42
)

# KFold CV
cv = KFold(n_splits=8, shuffle=True, random_state=42)

# ====================== 模型定义 ======================
models = {
    "Ridge": Ridge(alpha=5.0),
    "KNN": KNeighborsRegressor(n_neighbors=10, weights='distance', p=1),
    "SVR": SVR(C=2.0, kernel='rbf', epsilon=0.05, gamma='scale'),
    "DecisionTree": DecisionTreeRegressor(max_depth=4, min_samples_leaf=4, random_state=42),
    "RandomForest": RandomForestRegressor(
        n_estimators=200, max_depth=4, min_samples_split=5, min_samples_leaf=3,
        random_state=42, n_jobs=-1
    ),
    "GradientBoosting": GradientBoostingRegressor(
        n_estimators=100, learning_rate=0.03, max_depth=2, subsample=0.7, random_state=42
    ),
    "XGBoost": xgb.XGBRegressor(
        n_estimators=150,
        learning_rate=0.03,
        max_depth=3,
        subsample=0.7,
        colsample_bytree=0.7,
        reg_alpha=0.2,
        reg_lambda=5,
        objective='reg:squarederror',
        random_state=42,
        n_jobs=1
    )
}

# ====================== 模型训练 & 评估 ======================
results = []

print("\n========== Training Models ==========")
for name, model in models.items():
    print(f"\nTraining {name}...")

    if name == 'XGBoost':
        eval_set = [(X_train, y_train), (X_test, y_test)]
        model.fit(
            X_train, y_train,
            eval_set=eval_set,
            eval_metric='rmse',
            early_stopping_rounds=20,
            verbose=False
        )
    else:
        # 其他模型直接 fit
        model.fit(X_train, y_train)

    # 预测
    y_train_pred = model.predict(X_train)
    y_test_pred = model.predict(X_test)

    # 指标
    train_r2 = r2_score(y_train, y_train_pred)
    test_r2 = r2_score(y_test, y_test_pred)
    cv_scores = cross_val_score(model, X_train, y_train, cv=cv, scoring='r2')

    print(f"Train R2: {train_r2:.4f}")
    print(f"Test R2:  {test_r2:.4f}")
    print(f"CV Mean:  {cv_scores.mean():.4f}")

    results.append([name, train_r2, test_r2, cv_scores.mean()])

    # 保存模型
    jl.dump(model, os.path.join(SAVE_FOLDER, f'{name}_final.pkl'))

# ====================== 结果汇总 ======================
results_df = pd.DataFrame(results, columns=["Model", "Train_R2", "Test_R2", "CV_R2"])
results_df = results_df.sort_values("Test_R2", ascending=False)

print("\n======= Final Results =======")
print(results_df)

results_df.to_csv(os.path.join(SAVE_FOLDER, 'model_final_performance.csv'), index=False)
