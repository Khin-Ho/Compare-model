import os
import tempfile
import numpy as np
import pandas as pd

from sklearn.model_selection import train_test_split, GridSearchCV, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score

from sklearn.tree import DecisionTreeRegressor
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor

import xgboost as xgb
import joblib as jl

# ====================== 临时文件夹修正 ======================
tempfile.tempdir = r"C:\Temp"
os.makedirs(tempfile.tempdir, exist_ok=True)

# ====================== 路径 ======================
DATA_PATH = r"E:\桌面\Milk\数据库-积分强度.xlsx"
SAVE_FOLDER = r"E:\桌面\Milk\数据库-积分强度"
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== 读取数据 ======================
df = pd.read_excel(DATA_PATH)
df = df.rename(columns={'PS(%)': 'PS', 'KOH(%)': 'KOH'})

# ====================== 特征工程 ======================
df['Reaction_Intensity'] = df['PS'] * df['KOH']
df['Dosage_Ratio'] = df['KOH'] / (df['PS'] + 1e-6)
df['Degradation_Potential'] = (df['R1o'] + df['R2o']) / (df['R5o'] + 1e-6)

# ====================== 标签 ======================
y = df['HIX'].values

# ====================== 特征列表 ======================
features = [
    'PS', 'KOH',
    'Reaction_Intensity',
    'Dosage_Ratio',
    'Degradation_Potential',
    'R5o', 'R4o', 'R3o', 'R2o', 'R1o'
]

X = df[features].values

# ====================== 数据集划分 ======================
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=28
)

# ====================== 标准化（只给 Ridge/KNN/SVR 用） ======================
scaler_X = StandardScaler()
X_train_scaled = scaler_X.fit_transform(X_train)
X_test_scaled = scaler_X.transform(X_test)

jl.dump(scaler_X, os.path.join(SAVE_FOLDER, "scaler_X.pkl"))

# ====================== 模型字典 ======================
models = {
    "Ridge": Ridge(),
    "KNN": KNeighborsRegressor(),
    "SVR": SVR(),

    "DecisionTree": DecisionTreeRegressor(random_state=28),
    "RandomForest": RandomForestRegressor(random_state=28),
    "GradientBoosting": GradientBoostingRegressor(random_state=28),

    "XGBoost": xgb.XGBRegressor(
        random_state=28,
        objective="reg:squarederror",
        tree_method="hist",
        n_jobs=1
    )
}

# ====================== 超参数网格（增强版） ======================
param_grid = {
    "Ridge": {
        "alpha": [0.01, 0.1, 1, 5, 10, 50, 100]
    },

    "KNN": {
        "n_neighbors": [3, 5, 7, 9, 11, 13],
        "weights": ["uniform", "distance"],
        "p": [1, 2]
    },

    "SVR": {
        "kernel": ["rbf"],
        "C": [0.1, 1, 5, 10, 50, 100, 200],
        "epsilon": [0.001, 0.01, 0.05, 0.1, 0.2],
        "gamma": ["scale", 0.01, 0.05, 0.1, 0.5, 1]
    },

    "DecisionTree": {
        "max_depth": [3, 4, 5, 6, 8, 10, None],
        "min_samples_split": [2, 5, 10, 20],
        "min_samples_leaf": [1, 2, 3, 5]
    },

    "RandomForest": {
        "n_estimators": [200, 400, 600, 800],
        "max_depth": [4, 6, 8, 10, 15, None],
        "min_samples_split": [2, 5, 10, 20],
        "min_samples_leaf": [1, 2, 4],
        "max_features": ["sqrt", "log2", 0.6, 0.8],
        "bootstrap": [True, False]
    },

    "GradientBoosting": {
        "n_estimators": [200, 400, 600],
        "learning_rate": [0.01, 0.03, 0.05, 0.1],
        "max_depth": [2, 3, 4, 5],
        "subsample": [0.7, 0.8, 0.9, 1.0],
        "min_samples_split": [2, 5, 10],
        "min_samples_leaf": [1, 2, 4]
    },

    "XGBoost": {
        "n_estimators": [300, 500, 800, 1200],
        "learning_rate": [0.01, 0.03, 0.05, 0.1],
        "max_depth": [3, 4, 5, 6, 8, 10],
        "subsample": [0.6, 0.7, 0.8, 0.9, 1.0],
        "colsample_bytree": [0.6, 0.7, 0.8, 0.9, 1.0],
        "colsample_bylevel": [0.6, 0.8, 1.0],
        "min_child_weight": [1, 3, 5, 8],
        "gamma": [0, 0.05, 0.1, 0.2, 0.5],
        "reg_alpha": [0, 0.01, 0.1, 0.5, 1],
        "reg_lambda": [0.5, 1, 2, 5, 10]
    }
}

# ====================== 训练与评估 ======================
results = []

for name, model in models.items():
    print(f"\nTraining {name} ...")

    # ⭐ Ridge/KNN/SVR 使用标准化数据
    if name in ["Ridge", "KNN", "SVR"]:
        Xtr, Xte = X_train_scaled, X_test_scaled
    else:
        Xtr, Xte = X_train, X_test

    grid = GridSearchCV(
        model,
        param_grid[name],
        cv=5,
        scoring="r2",
        n_jobs=1,
        verbose=1
    )

    grid.fit(Xtr, y_train)
    best_model = grid.best_estimator_

    train_r2 = r2_score(y_train, best_model.predict(Xtr))
    test_r2 = r2_score(y_test, best_model.predict(Xte))

    cv_r2 = cross_val_score(
        best_model, Xtr, y_train, cv=5, scoring="r2", n_jobs=1
    ).mean()

    print(f"{name} | Train R2: {train_r2:.3f}, Test R2: {test_r2:.3f}, CV R2: {cv_r2:.3f}")
    print(f"Best Params: {grid.best_params_}")

    jl.dump(best_model, os.path.join(SAVE_FOLDER, f"{name}.pkl"))

    results.append({
        "Model": name,
        "Train_R2": train_r2,
        "Test_R2": test_r2,
        "CV_R2": cv_r2,
        "Best_Params": str(grid.best_params_)
    })

# ====================== 保存结果 ======================
results_df = pd.DataFrame(results)

results_df.to_csv(
    os.path.join(SAVE_FOLDER, "ML_results_optimized.csv"),
    index=False,
    encoding="utf-8-sig"
)

print("\n===== Final Results =====")
print(results_df[["Model", "Train_R2", "Test_R2", "CV_R2"]])
print(f"\nResults saved to: {SAVE_FOLDER}")
