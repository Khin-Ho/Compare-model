# ====================== CONFIG 区 ======================
DATA_PATH = r"E:\桌面\soy\remove dataset for other.xlsx"
MATERIAL_FILTER = None
FEATURES = ["PS", "KOH", "R1o", "R2o", "R3o", "R4o", "R5o"]
TARGET = "HIX"
TEST_SIZE = 0.2
RANDOM_STATE = 42
CV_FOLDS = 5
N_JOBS = -1
N_TRIALS = 20                   # 每个模型的 Optuna 试验次数（越大越准但越慢）
SAVE_FOLDER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "out", "V11.7")
