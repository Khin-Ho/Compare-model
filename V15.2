import os
import numpy as np
import pandas as pd
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# V15.2：在 V15.1 基础上加入缺失值清洗、MAE 和 RMSE
DATA_PATH = r"E:\桌面\Milk\积分milk.xlsx"
SAVE_FOLDER = r"E:\桌面\Milk\V15.2_results"
RANDOM_STATE = 888
os.makedirs(SAVE_FOLDER, exist_ok=True)

df = pd.read_excel(DATA_PATH).rename(columns={"PS(%)": "PS", "KOH(%)": "KOH"})
required = ["PS", "KOH", "R1o", "R2o", "R3o", "R4o", "R5o", "HIX"]
missing = [column for column in required if column not in df.columns]
if missing:
    raise ValueError(f"缺少必要列: {missing}")
df = df.dropna(subset=required).reset_index(drop=True)
eps = 1e-8
df["Reaction_Intensity"] = df["PS"] * df["KOH"]
df["Dosage_Ratio"] = df["PS"] / (df["KOH"] + eps)
df["Degradation_Potential"] = (df["R1o"] + df["R2o"]) / (df["R5o"] + eps)
features = required[:-1] + [
    "Reaction_Intensity", "Dosage_Ratio", "Degradation_Potential"
]

X_train, X_test, y_train, y_test = train_test_split(
    df[features], df["HIX"], test_size=0.2, random_state=RANDOM_STATE
)
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)
model = GradientBoostingRegressor(
    n_estimators=200, learning_rate=0.03, max_depth=3,
    random_state=RANDOM_STATE
)
model.fit(X_train, y_train)
pred = model.predict(X_test)
metrics = {
    "R2": r2_score(y_test, pred),
    "MAE": mean_absolute_error(y_test, pred),
    "RMSE": np.sqrt(mean_squared_error(y_test, pred)),
}
pd.DataFrame([metrics]).to_csv(
    os.path.join(SAVE_FOLDER, "metrics.csv"), index=False, encoding="utf-8-sig"
)
pd.DataFrame({"Observed_HIX": y_test, "Predicted_HIX": pred}).to_csv(
    os.path.join(SAVE_FOLDER, "predictions.csv"), index=False, encoding="utf-8-sig"
)
print(f"V15.2 完成：R2={metrics['R2']:.3f}, RMSE={metrics['RMSE']:.3f}")
