import os
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import r2_score, mean_squared_error
import shap
import matplotlib.pyplot as plt

# ====================== 路径 ======================
DATA_PATH = r"E:\桌面\Milk\积分milk.xlsx"
SAVE_FOLDER = r"E:\桌面\Milk\Feature_Analysis"
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== 1️⃣ 读取数据 ======================
df = pd.read_excel(DATA_PATH)
df = df.rename(columns={'PS(%)': 'PS', 'KOH(%)': 'KOH'})

# ====================== 2️⃣ 特征工程 ======================
df['Reaction_Intensity'] = df['PS'] * df['KOH']
df['Dosage_Ratio'] = df['PS'] / (df['KOH'] + 0.01)
df['Degradation_Potential'] = (df['R1o'] + df['R2o']) / (df['R5o'] + 0.01)

features = ['PS', 'KOH', 'R1o', 'R2o', 'R3o', 'R4o', 'R5o',
            'Reaction_Intensity', 'Dosage_Ratio', 'Degradation_Potential']

X = df[features].values
y = df['HIX'].values  # 原始 HIX 或 Excel 已归一化的 HIX

# ====================== 3️⃣ 数据划分 & 标准化 ======================
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=74
)
scaler = StandardScaler()
X_train_s = scaler.fit_transform(X_train)
X_test_s = scaler.transform(X_test)

# ====================== 4️⃣ 模型训练 ======================
gbr = GradientBoostingRegressor(
    n_estimators=200,
    max_depth=4,
    learning_rate=0.03,
    random_state=74
)
gbr.fit(X_train_s, y_train)

# ====================== 5️⃣ 预测 & 性能 ======================
y_pred = gbr.predict(X_test_s)
r2 = r2_score(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
print(f"Test R2: {r2:.3f}, RMSE: {rmse:.3f}")

# ====================== 6️⃣ SHAP 分析 ======================
explainer = shap.TreeExplainer(gbr)
shap_values = explainer.shap_values(X_train_s)

# 绘制 SHAP Summary Plot
plt.figure(figsize=(10,6))
shap.summary_plot(shap_values, pd.DataFrame(X_train_s, columns=features), show=False)
plt.tight_layout()
plt.savefig(os.path.join(SAVE_FOLDER, 'SHAP_Feature_Importance.png'), dpi=300)
plt.close()

# ====================== 7️⃣ 输出每个特征贡献度 ======================
shap_mean = np.abs(shap_values).mean(axis=0)
feature_importance = pd.DataFrame({
    'Feature': features,
    'Mean_Abs_SHAP': shap_mean
}).sort_values(by='Mean_Abs_SHAP', ascending=False)

feature_importance.to_csv(os.path.join(SAVE_FOLDER, 'Feature_Contribution.csv'), index=False)
print("特征贡献度排名已保存！")
print(feature_importance)

# ====================== 8️⃣ 示例：预测新样品 ======================
# 假设你测完新样品的指标放在 new_sample_dict
new_sample_dict = {
    'PS': 0.5,
    'KOH': 0.3,
    'R1o': 1.2,
    'R2o': 0.8,
    'R3o': 0.5,
    'R4o': 0.4,
    'R5o': 0.7
}
new_sample_dict['Reaction_Intensity'] = new_sample_dict['PS'] * new_sample_dict['KOH']
new_sample_dict['Dosage_Ratio'] = new_sample_dict['PS'] / (new_sample_dict['KOH'] + 0.01)
new_sample_dict['Degradation_Potential'] = (new_sample_dict['R1o'] + new_sample_dict['R2o']) / (new_sample_dict['R5o'] + 0.01)

new_sample = pd.DataFrame([new_sample_dict])
new_sample_scaled = scaler.transform(new_sample[features])
predicted_HIX = gbr.predict(new_sample_scaled)[0]
print(f"新样品预测 HIX: {predicted_HIX:.3f}")
