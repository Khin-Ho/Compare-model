import os
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split, GridSearchCV, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.neural_network import MLPRegressor
from sklearn.ensemble import RandomForestRegressor
import xgboost as xgb
import joblib as jl
import matplotlib.pyplot as plt
import seaborn as sns

# ====================== Configuration ======================
DATA_PATH = r"E:\桌面\6\ML_ready\HIX_train_ready.csv"
SAVE_FOLDER = r"E:\桌面\6\ML_ready"
IMAGE_FOLDER = os.path.join(SAVE_FOLDER, 'model_results')
os.makedirs(IMAGE_FOLDER, exist_ok=True)

plt.rcParams['font.sans-serif'] = ['DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# ====================== Data Loading ======================
print("Loading data...")
df = pd.read_csv(DATA_PATH, encoding="utf-8-sig")
print(f"Data shape: {df.shape}")

features = ['PS', 'KOH', 'Microwave', 'R1', 'R2', 'R3', 'R4', 'R5']
X = df[features].values
y = df['HIX_normalized'].values

# Scale features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# ====================== Dataset Splitting ======================
X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y, test_size=0.2, random_state=42
)
print(f"Training set: {X_train.shape}, Test set: {X_test.shape}")

# ====================== Models ======================
models = {
    "XGBoost": xgb.XGBRegressor(
        n_estimators=1000,
        learning_rate=0.01,
        max_depth=6,
        subsample=0.8,
        colsample_bytree=0.8,
        reg_alpha=0.1,
        reg_lambda=1.0,
        random_state=42,
        n_jobs=-1
    ),
    "MLP": MLPRegressor(
        hidden_layer_sizes=(128, 64, 32),
        activation='relu',
        solver='adam',
        alpha=0.001,
        learning_rate_init=0.001,
        max_iter=2000,
        random_state=42
    ),
    "RandomForest": RandomForestRegressor(
        n_estimators=500,
        max_depth=10,
        random_state=42,
        n_jobs=-1
    )
}

results = []

# ====================== Training and Evaluation ======================
for model_name, model in models.items():
    print(f"\nTraining {model_name}...")
    model.fit(X_train, y_train)

    y_train_pred = model.predict(X_train)
    y_test_pred = model.predict(X_test)

    train_r2 = r2_score(y_train, y_train_pred)
    test_r2 = r2_score(y_test, y_test_pred)
    train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))
    test_rmse = np.sqrt(mean_squared_error(y_test, y_test_pred))

    cv_scores = cross_val_score(model, X_train, y_train, cv=5, scoring='r2')
    cv_mean = cv_scores.mean()
    cv_std = cv_scores.std()

    print(f"  Train R2: {train_r2:.4f}")
    print(f"  Test R2: {test_r2:.4f}")
    print(f"  Test RMSE: {test_rmse:.4f}")
    print(f"  CV R2: {cv_mean:.4f} ± {cv_std:.4f}")

    jl.dump(model, os.path.join(SAVE_FOLDER, f'{model_name}_model.pkl'))

    results.append({
        'Model': model_name,
        'Train_R2': train_r2,
        'Test_R2': test_r2,
        'Train_RMSE': train_rmse,
        'Test_RMSE': test_rmse,
        'CV_R2_mean': cv_mean,
        'CV_R2_std': cv_std
    })

# ====================== Results Summary ======================
results_df = pd.DataFrame(results).sort_values('Test_R2', ascending=False)
print("\nFINAL RESULTS SUMMARY")
print(results_df)

results_path = os.path.join(SAVE_FOLDER, 'model_performance_v2.csv')
results_df.to_csv(results_path, index=False)
print(f"\nResults saved to: {results_path}")

# ====================== Feature Importance (XGBoost) ======================
xgb_model = models["XGBoost"]
importance = xgb_model.feature_importances_
plt.figure(figsize=(8,6))
sns.barplot(x=importance, y=features)
plt.title("XGBoost Feature Importance")
plt.tight_layout()
plt.savefig(os.path.join(IMAGE_FOLDER, "xgb_feature_importance.png"))
plt.show()
