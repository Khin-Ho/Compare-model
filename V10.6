import os
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split, RepeatedKFold, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor, VotingRegressor
from sklearn.metrics import mean_squared_error, r2_score
import joblib as jl
import matplotlib.pyplot as plt
import seaborn as sns
import xgboost as xgb

# ====================== Configuration ======================
DATA_PATH = r"E:\桌面\6\ML_ready\HIX_train_ready.csv"
SAVE_FOLDER = r"E:\桌面\6\ML_ready"
IMAGE_FOLDER = os.path.join(SAVE_FOLDER, 'model_results')
os.makedirs(IMAGE_FOLDER, exist_ok=True)

plt.rcParams['font.sans-serif'] = ['DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# ====================== Data Loading ======================
print("Loading data...")
df = pd.read_csv(DATA_PATH, encoding="utf-8-sig")
print(f"Data shape: {df.shape}")
print("Checking for missing values...")
print(df.isnull().sum())

# ====================== Features ======================
features = ['PS', 'KOH', 'Microwave', 'R1', 'R2', 'R3', 'R4', 'R5']
X = df[features].values
y = df['HIX_normalized'].values

# ====================== Feature Scaling + PCA ======================
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
pca = PCA(n_components=0.95)  # 保留95%方差
X_pca = pca.fit_transform(X_scaled)
print(f"Original features: {X.shape[1]}, After PCA: {X_pca.shape[1]}")

# ====================== Train/Test Split ======================
X_train, X_test, y_train, y_test = train_test_split(
    X_pca, y, test_size=0.2, random_state=42
)
print(f"Training set: {X_train.shape}, Test set: {X_test.shape}")

# ====================== Model Definitions ======================
ridge = Ridge(alpha=20)
knn = KNeighborsRegressor(n_neighbors=10, weights='uniform', p=1)
xgb_model = xgb.XGBRegressor(
    n_estimators=50, max_depth=3, learning_rate=0.05,
    subsample=0.7, colsample_bytree=0.7, reg_lambda=10,
    random_state=42, n_jobs=-1
)

voting = VotingRegressor([
    ('ridge', ridge),
    ('knn', knn),
    ('xgb', xgb_model)
])

other_models = {
    "SVR": SVR(C=0.1, epsilon=0.1, kernel='rbf'),
    "DecisionTree": DecisionTreeRegressor(max_depth=3, min_samples_leaf=5, random_state=42),
    "RandomForest": RandomForestRegressor(n_estimators=50, max_depth=3, min_samples_leaf=5, random_state=42, n_jobs=-1),
    "GradientBoosting": GradientBoostingRegressor(n_estimators=50, learning_rate=0.05, max_depth=3, random_state=42),
}

# ====================== Cross-Validation ======================
rkf = RepeatedKFold(n_splits=5, n_repeats=3, random_state=42)

results = []

def evaluate_model(name, model):
    print(f"\nTraining {name}...")
    model.fit(X_train, y_train)
    y_train_pred = model.predict(X_train)
    y_test_pred = model.predict(X_test)

    train_r2 = r2_score(y_train, y_train_pred)
    test_r2 = r2_score(y_test, y_test_pred)
    train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))
    test_rmse = np.sqrt(mean_squared_error(y_test, y_test_pred))
    cv_scores = cross_val_score(model, X_train, y_train, cv=rkf, scoring='r2')
    cv_mean, cv_std = cv_scores.mean(), cv_scores.std()

    print(f"  Train R2: {train_r2:.4f}")
    print(f"  Test R2: {test_r2:.4f}")
    print(f"  Test RMSE: {test_rmse:.4f}")
    print(f"  CV R2: {cv_mean:.4f} ± {cv_std:.4f}")

    jl.dump(model, os.path.join(SAVE_FOLDER, f'{name}_model.pkl'))

    results.append({
        'Model': name,
        'Train_R2': train_r2,
        'Test_R2': test_r2,
        'Train_RMSE': train_rmse,
        'Test_RMSE': test_rmse,
        'CV_R2_mean': cv_mean,
        'CV_R2_std': cv_std
    })

# ====================== Train Voting + Other Models ======================
evaluate_model("VotingRegressor", voting)
for name, model in other_models.items():
    evaluate_model(name, model)

# ====================== Results Summary ======================
results_df = pd.DataFrame(results).sort_values('Test_R2', ascending=False)
print("\n" + "=" * 60)
print("FINAL RESULTS SUMMARY")
print("=" * 60)
for i, row in results_df.iterrows():
    print(f"{row['Model']:15s} | Test R2: {row['Test_R2']:.4f} | Train R2: {row['Train_R2']:.4f} | CV R2: {row['CV_R2_mean']:.4f} ± {row['CV_R2_std']:.4f}")

results_path = os.path.join(SAVE_FOLDER, 'model_performance.csv')
results_df.to_csv(results_path, index=False)
print(f"\nResults saved to: {results_path}")
