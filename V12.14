import os
import tempfile
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")  # 避免 PyCharm 图形后端报错
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split, GridSearchCV, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.tree import DecisionTreeRegressor
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.metrics import r2_score
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.inspection import PartialDependenceDisplay
import xgboost as xgb
import shap
import joblib as jl

# ====================== 临时文件夹 ======================
tempfile.tempdir = r"C:\Temp"
os.makedirs(tempfile.tempdir, exist_ok=True)

# ====================== 路径 ======================
DATA_PATH = r"E:\桌面\Milk\积分milk.xlsx"
SAVE_FOLDER = r"E:\桌面\Milk\model2"
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== 读取数据 ======================
df = pd.read_excel(DATA_PATH)
df = df.rename(columns={'PS(%)': 'PS', 'KOH(%)': 'KOH'})

# ====================== 特征工程 ======================
df['Reaction_Intensity'] = df['PS'] * df['KOH']
df['Dosage_Ratio'] = df['PS'] / (df['KOH'] + 0.01)
df['Degradation_Potential'] = (df['R1o'] + df['R2o']) / (df['R5o'] + 0.01)

# ====================== 目标变量 ======================
y = df['HIX'].values

# ====================== 特征列表 ======================
features = ['PS', 'KOH', 'Reaction_Intensity', 'Dosage_Ratio', 'Degradation_Potential',
            'R5o','R4o','R3o','R2o','R1o']
X = df[features].values

# ====================== 数据集划分 ======================
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=28
)

# ====================== 标准化 ======================
scaler_X = StandardScaler()
X_train_scaled = scaler_X.fit_transform(X_train)
X_test_scaled = scaler_X.transform(X_test)
jl.dump(scaler_X, os.path.join(SAVE_FOLDER, "scaler_X.pkl"))

# ====================== 模型定义 ======================
models = {
    "Ridge": Ridge(),
    "KNN": KNeighborsRegressor(),
    "SVR": SVR(),
    "DecisionTree": DecisionTreeRegressor(random_state=28),
    "RandomForest": RandomForestRegressor(random_state=28),
    "GradientBoosting": GradientBoostingRegressor(random_state=28),
    "XGBoost": xgb.XGBRegressor(random_state=28, n_jobs=1)
}

# ====================== 超参数 ======================
param_grid = {
    'Ridge': {'alpha': [0.1, 1, 5, 10, 20]},
    'KNN': {'n_neighbors': [3, 5, 7, 9], 'weights': ['uniform', 'distance'], 'p': [1, 2]},
    'SVR': {'C': [0.1, 1, 5, 10], 'epsilon': [0.01, 0.05, 0.1], 'kernel': ['rbf', 'linear']},
    'DecisionTree': {'max_depth': [3, 4, 5, 6], 'min_samples_split': [2, 5, 10], 'min_samples_leaf': [1, 2, 3]},
    'RandomForest': {'n_estimators': [100, 150, 200], 'max_depth': [4, 6, 8], 'min_samples_split': [2, 5, 10], 'min_samples_leaf': [1, 2]},
    'GradientBoosting': {'n_estimators': [100, 150, 200], 'learning_rate': [0.01, 0.03, 0.05], 'max_depth': [3, 4, 5]},
    'XGBoost': {'n_estimators': [100, 150, 200], 'learning_rate': [0.01, 0.03, 0.05],
                'max_depth': [3, 4, 5], 'subsample': [0.7, 0.8, 1.0], 'colsample_bytree': [0.7, 0.8, 1.0],
                'reg_alpha': [0, 0.1, 0.5, 1], 'reg_lambda': [1, 5, 10]}
}

# ====================== 训练 ======================
results = []

for name, model in models.items():
    print(f"\nTraining {name} ...")
    grid = GridSearchCV(model, param_grid[name], cv=5, scoring='r2', n_jobs=1, verbose=1)
    grid.fit(X_train_scaled, y_train)
    best_model = grid.best_estimator_

    train_r2 = r2_score(y_train, best_model.predict(X_train_scaled))
    test_r2 = r2_score(y_test, best_model.predict(X_test_scaled))
    cv_r2 = cross_val_score(best_model, X_train_scaled, y_train, cv=5, scoring='r2').mean()

    print(f"{name} | Train: {train_r2:.3f} | Test: {test_r2:.3f} | CV: {cv_r2:.3f}")
    jl.dump(best_model, os.path.join(SAVE_FOLDER, f"{name}.pkl"))
    results.append({'Model': name, 'Train_R2': train_r2, 'Test_R2': test_r2, 'CV_R2': cv_r2})

# ====================== 保存结果 ======================
results_df = pd.DataFrame(results)
results_df.to_csv(os.path.join(SAVE_FOLDER, "model_results.csv"), index=False)
print("\n===== Final Results =====")
print(results_df)

# ====================== 选择最优树模型 ======================
tree_models = results_df[results_df['Model'].isin(['RandomForest','GradientBoosting','XGBoost'])]
best_model_name = tree_models.sort_values(by='CV_R2', ascending=False).iloc[0]['Model']
print(f"\nBest model for interpretation: {best_model_name}")
best_model = jl.load(os.path.join(SAVE_FOLDER, f"{best_model_name}.pkl"))

# ====================== SHAP ======================
explainer = shap.Explainer(best_model.predict, X_train_scaled)
shap_values = explainer(X_train_scaled)

# SHAP summary
shap.summary_plot(shap_values.values, X_train_scaled, feature_names=features, show=False)
plt.tight_layout()
plt.savefig(os.path.join(SAVE_FOLDER, "SHAP_summary.png"), dpi=300)

# SHAP dependence for R5o
shap.dependence_plot("R5o", shap_values.values, X_train_scaled, feature_names=features, show=False)
plt.tight_layout()
plt.savefig(os.path.join(SAVE_FOLDER, "SHAP_R5o_dependence.png"), dpi=300)

# ====================== PDP ======================
pdp_features = ['R5o', 'Reaction_Intensity', 'PS']
fig, ax = plt.subplots(figsize=(8,6))
PartialDependenceDisplay.from_estimator(best_model, X_train_scaled,
                                        features=[features.index(f) for f in pdp_features],
                                        feature_names=features, ax=ax)
plt.tight_layout()
plt.savefig(os.path.join(SAVE_FOLDER, "PDP_key_features.png"), dpi=300)

print(f"\nAll models and interpretation figures saved to:\n{SAVE_FOLDER}")
