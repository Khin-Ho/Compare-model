import os
import json
import time
import logging
import warnings
import tempfile
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

# ====================== Windows 中文用户名 + joblib 修复 ======================
tempfile.tempdir = r"C:\Temp"
os.makedirs(tempfile.tempdir, exist_ok=True)
os.environ["JOBLIB_TEMP_FOLDER"] = tempfile.tempdir

import joblib as jl
import xgboost as xgb
from sklearn.model_selection import train_test_split, GridSearchCV, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.linear_model import Ridge
from sklearn.neighbors import KNeighborsRegressor
from sklearn.svm import SVR
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.metrics import mean_squared_error, r2_score

# ====================== CONFIG 区 ======================
DATA_PATH = r"E:\桌面\soy\remove dataset for other.xlsx"  # 数据路径（原 V11.0 路径已失效）
MATERIAL_FILTER = None          # None=全部数据; 'Soy'=仅大豆; 'Milk'=仅牛奶
# 特征：V11.0 用的 PS/KOH/R1-R5，当前数据里 'Microwave' 列已不存在，
# 如有原数据可自行加回；'HIXo'、'Tstart' 也可按需加入
FEATURES = ["PS", "KOH", "R1o", "R2o", "R3o", "R4o", "R5o"]
TARGET = "HIX"                  # V11.0 用的 'HIX_normalized'，当前数据 HIX 已在 0-1 区间
TEST_SIZE = 0.2
RANDOM_STATE = 42
CV_FOLDS = 5
N_JOBS = -1                     # -1=全部核心（种子固定，数值结果不受影响）；报错时改 1
SAVE_TOP_N = 3                  # 保存最优前 N 个模型
SAVE_FOLDER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "out", "V11.1")
os.makedirs(SAVE_FOLDER, exist_ok=True)

# ====================== 日志（V11.1 新增）======================
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[
        logging.FileHandler(os.path.join(SAVE_FOLDER, "run.log"), encoding="utf-8"),
        logging.StreamHandler(),
    ],
)
log = logging.getLogger("V11.1")


def log_config():
    """把本次运行的全部配置写入日志和 config.json，方便复现。"""
    cfg = {
        "DATA_PATH": DATA_PATH, "MATERIAL_FILTER": MATERIAL_FILTER,
        "FEATURES": FEATURES, "TARGET": TARGET, "TEST_SIZE": TEST_SIZE,
        "RANDOM_STATE": RANDOM_STATE, "CV_FOLDS": CV_FOLDS,
        "N_JOBS": N_JOBS, "SAVE_TOP_N": SAVE_TOP_N,
    }
    with open(os.path.join(SAVE_FOLDER, "config.json"), "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
    log.info("=" * 60)
    log.info("运行配置:")
    for k, v in cfg.items():
        log.info("  %s = %s", k, v)
    log.info("=" * 60)


# ====================== 数据加载 ======================
def load_data():
    if DATA_PATH.lower().endswith((".xlsx", ".xls")):
        df = pd.read_excel(DATA_PATH)
    else:
        df = pd.read_csv(DATA_PATH, encoding="utf-8-sig")
    df = df.rename(columns={"PS(%)": "PS", "KOH(%)": "KOH"})
    if MATERIAL_FILTER and "Material" in df.columns:
        df = df[df["Material"].astype(str).str.strip() == MATERIAL_FILTER].copy()
    for c in FEATURES + [TARGET]:
        if c in df.columns:
            df[c] = pd.to_numeric(df[c], errors="coerce")
    missing = [c for c in FEATURES + [TARGET] if c not in df.columns]
    if missing:
        raise KeyError(f"数据中缺少列: {missing}")
    df = df.dropna(subset=FEATURES + [TARGET]).reset_index(drop=True)
    return df


# ====================== 模型与超参数（与 V11.0 完全一致）======================
MODELS = {
    "Ridge": Ridge(),
    "KNN": KNeighborsRegressor(),
    "SVR": SVR(),
    "DecisionTree": DecisionTreeRegressor(random_state=RANDOM_STATE),
    "RandomForest": RandomForestRegressor(random_state=RANDOM_STATE),
    "GradientBoosting": GradientBoostingRegressor(random_state=RANDOM_STATE),
    "XGBoost": xgb.XGBRegressor(random_state=RANDOM_STATE),
}

PARAM_GRID = {
    'Ridge': {'alpha': [1, 5, 10, 20]},
    'KNN': {'n_neighbors': [3, 5, 7, 10], 'weights': ['uniform', 'distance'], 'p': [1, 2]},
    'SVR': {'C': [0.1, 1, 10], 'epsilon': [0.01, 0.1, 0.2], 'kernel': ['rbf', 'linear']},
    'DecisionTree': {'max_depth': [2, 3, 4, 5], 'min_samples_split': [2, 5, 10], 'min_samples_leaf': [1, 2, 4]},
    'RandomForest': {'n_estimators': [50, 100, 150], 'max_depth': [3, 5, 7, 10], 'min_samples_split': [2, 5, 10], 'min_samples_leaf': [1, 2, 4]},
    'GradientBoosting': {'n_estimators': [50, 100, 150], 'learning_rate': [0.01, 0.03, 0.05], 'max_depth': [2, 3, 4, 5]},
    'XGBoost': {'n_estimators': [50, 100, 150], 'learning_rate': [0.01, 0.03, 0.05], 'max_depth': [2, 3, 4, 5],
                'subsample': [0.7, 0.8, 1.0], 'colsample_bytree': [0.7, 0.8, 1.0], 'reg_alpha': [0, 0.1, 1], 'reg_lambda': [1, 10]},
}


def main():
    t0 = time.time()
    log_config()

    # ---------- 数据 ----------
    log.info("Loading data...")
    df = load_data()
    log.info("Data shape: %s", df.shape)
    X = df[FEATURES]
    y = df[TARGET].values

    # ---------- 标准化 + PCA ----------
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    pca = PCA(n_components=0.95)
    X_pca = pca.fit_transform(X_scaled)
    log.info("Original features: %d, After PCA: %d", X.shape[1], X_pca.shape[1])

    # ---------- 数据集拆分 ----------
    X_train, X_test, y_train, y_test = train_test_split(
        X_pca, y, test_size=TEST_SIZE, random_state=RANDOM_STATE)
    log.info("Training set: %s, Test set: %s", X_train.shape, X_test.shape)

    # ---------- 训练与评估（结果边跑边存）----------
    results_path = os.path.join(SAVE_FOLDER, "all_model_results.csv")
    if os.path.exists(results_path):
        os.remove(results_path)  # 每次运行重新生成

    results = []
    for name, model in MODELS.items():
        t_model = time.time()
        log.info("\nTraining %s ...", name)
        if name in PARAM_GRID:
            grid = GridSearchCV(model, PARAM_GRID[name], cv=CV_FOLDS,
                                scoring='r2', n_jobs=N_JOBS, verbose=0)
            grid.fit(X_train, y_train)
            best_model = grid.best_estimator_
            log.info("Best params for %s: %s", name, grid.best_params_)
        else:
            best_model = model
            best_model.fit(X_train, y_train)

        y_train_pred = best_model.predict(X_train)
        y_test_pred = best_model.predict(X_test)

        train_r2 = r2_score(y_train, y_train_pred)
        test_r2 = r2_score(y_test, y_test_pred)
        train_rmse = np.sqrt(mean_squared_error(y_train, y_train_pred))
        test_rmse = np.sqrt(mean_squared_error(y_test, y_test_pred))
        cv_scores = cross_val_score(best_model, X_train, y_train, cv=CV_FOLDS, scoring='r2', n_jobs=N_JOBS)

        elapsed = time.time() - t_model
        log.info("Train R2: %.4f, Test R2: %.4f, CV R2: %.4f +/- %.4f (%.1fs)",
                 train_r2, test_r2, cv_scores.mean(), cv_scores.std(), elapsed)

        result = {
            'Model': name,
            'Train_R2': train_r2, 'Test_R2': test_r2,
            'Train_RMSE': train_rmse, 'Test_RMSE': test_rmse,
            'CV_R2_mean': cv_scores.mean(), 'CV_R2_std': cv_scores.std(),
            'Best_Params': str(grid.best_params_) if name in PARAM_GRID else "default",
            'Time_sec': round(elapsed, 1),
            'Model_object': best_model,
        }
        results.append(result)

        # 边跑边存：每完成一个模型立即追加写入（V11.1 新增）
        row_df = pd.DataFrame([{k: v for k, v in result.items() if k != 'Model_object'}])
        header = not os.path.exists(results_path)
        row_df.to_csv(results_path, mode='a', header=header, index=False, encoding='utf-8-sig')

    # ---------- 排序并保存最优模型（与 V11.0 相同）----------
    results_sorted = sorted(results, key=lambda x: x['Test_R2'], reverse=True)
    top_n = results_sorted[:SAVE_TOP_N]
    for i, result in enumerate(top_n):
        jl.dump(result['Model_object'],
                os.path.join(SAVE_FOLDER, f"top_{i + 1}_model_{result['Model']}.pkl"))
        log.info("Saved top %d model: %s", i + 1, result['Model'])

    # ---------- 汇总 ----------
    results_df = pd.DataFrame([
        {k: v for k, v in r.items() if k != 'Model_object'} for r in results_sorted])
    results_df.to_csv(os.path.join(SAVE_FOLDER, 'top_3_model_performance.csv'),
                      index=False, encoding='utf-8-sig')  # 全表在 all_model_results.csv
    log.info("\n===== Final Results (sorted by Test R2) =====")
    log.info("\n" + results_df.drop(columns=['Best_Params', 'Time_sec']).to_string(index=False))
    log.info("Total time: %.1f min", (time.time() - t0) / 60)
    log.info("All outputs saved to: %s", SAVE_FOLDER)


if __name__ == "__main__":
    main()
